# Normalise text files in the repository.
* text=auto

# Files executed by Linux (Docker container, CI, git hooks) must keep LF
# endings, or the shell fails with "bad interpreter: /bin/bash^M".
*.sh        text eol=lf
.githooks/* text eol=lf
entrypoint.sh text eol=lf

# Binary assets - never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.h5   binary
*.pkl  binary
*.pdf  binary
