# Shared settings for the infra/aws scripts. Edit, then:  source config.env
#
# Frankfurt is the closest region to Fulda. CloudFront is global, so its
# default *.cloudfront.net certificate works regardless of this choice.
export AWS_REGION=eu-central-1

# Must be globally unique across all of AWS - change the suffix.
export PROJECT=fulda-bazaar
export UPLOADS_BUCKET=${PROJECT}-uploads-$(whoami | tr -cd 'a-z0-9')
export FRONTEND_BUCKET=${PROJECT}-frontend-$(whoami | tr -cd 'a-z0-9')

# Alert when spend crosses these USD amounts (of the $200 credit).
export BUDGET_LIMIT=20
export BUDGET_EMAIL=gauravbhamare33@gmail.com
