# Copy to .env and fill in real values. Never commit .env.
ENV=development

# --- URLs ---
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# --- MySQL (must match docker-compose.yml) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=myapp_db
DB_HOST=mysql
DB_PORT=3306
DB_DB=myapp_db
DATABASE_URL=mysql+asyncmy://admin:change_me@mysql:3306/myapp_db

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_your_own
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Message encryption (Fernet) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_CRYPT_KEY=generate_your_own

# --- Google Cloud Storage (optional; image upload is disabled without it) ---
# Path to a service-account JSON key. Keep it OUT of git.
GCP_CRED_FILE=gcp_service_account.json
GCP_PROJECT_ID=your-project-id
GCP_BUCKET_NAME=your-bucket-name
