# Copy to .env and fill in real values. Never commit .env.
ENV=development

# --- URLs ---
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# --- MySQL (must match docker-compose.yml) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=myapp_db
DB_HOST=mysql
DB_PORT=3306
DB_DB=myapp_db
DATABASE_URL=mysql+asyncmy://admin:change_me@mysql:3306/myapp_db

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_your_own
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Message encryption (Fernet) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_CRYPT_KEY=generate_your_own

# --- Object storage ---
# local = write to disk and serve from the app (no cloud account needed)
# s3    = write to an S3 bucket
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL_PREFIX=/media

# Everything below is only read when STORAGE_BACKEND=s3.
#
# The bucket stays private; CloudFront reads it through an Origin Access
# Control, so AWS_S3_PUBLIC_BASE_URL must be the CloudFront domain. Point it
# at the raw bucket URL and every image 403s.
# AWS_S3_BUCKET=your-uploads-bucket
# AWS_REGION=eu-central-1
# AWS_S3_PUBLIC_BASE_URL=https://your-distribution.cloudfront.net
#
# Credentials follow the standard boto3 chain. Running in Docker locally,
# supply keys for an IAM user scoped to this one bucket (see
# infra/aws/app-s3-policy.json) - never an admin key. On EC2, delete these
# two lines and attach an instance role instead: boto3 finds it by itself
# and there is no secret to leak.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional ML toxicity filter ---
# Needs requirements-ml.txt (~2GB, TensorFlow). Off by default.
ENABLE_TOXICITY=false

# --- CORS ---
# Comma-separated. Defaults cover the Vite dev server and local nginx.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
