# Copy to .env.local for local frontend development.
# Vite only exposes variables prefixed with VITE_.
VITE_API_URL=http://localhost:8000

# Google Maps JS API key (map view + address autocomplete).
# Restrict it by HTTP referrer in the Google Cloud console - it is
# shipped to the browser and is therefore public by nature.
VITE_GOOGLE_MAPS_API_KEY=your_maps_api_key
